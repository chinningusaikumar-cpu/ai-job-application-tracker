# Local development defaults are documented in README.md
# For deployment, generate a long random secret and set DATABASE_URL to PostgreSQL.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
DATABASE_URL=sqlite:///./global_job_search.db

# Optional: enable local/country listings via Adzuna. Register for credentials at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
